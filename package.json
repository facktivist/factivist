{
  "name": "factivist",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/ui/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=!@factivist/mobile",
    "dev:mobile": "turbo run dev --filter=@factivist/mobile",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "turbo run lint test:coverage build",
    "db:generate": "turbo run db:generate",
    "db:migrate": "[ -f .env ] && set -a && . ./.env && set +a; turbo run db:migrate",
    "db:migrate:age": "[ -f .env ] && set -a && . ./.env && set +a; turbo run db:migrate:age",
    "db:seed": "[ -f .env ] && set -a && . ./.env && set +a; turbo run db:seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "kuzu:explorer": "docker compose --profile tools up -d kuzu-explorer"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.7",
    "lefthook": "^2.1.8",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24.0.0"
  },
  "overrides": {
    "react-native": "^0.85.3"
  },
  "trustedDependencies": [
    "kuzu"
  ],
  "dependencies": {
    "@tanstack/ai": "^0.21.2",
    "@tanstack/ai-openai": "^0.10.0"
  }
}
