{
  "name": "@factivist/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:prebuild": "expo prebuild --clean",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug"
  },
  "dependencies": {
    "@factivist/shared": "workspace:*",
    "@factivist/ui-native": "workspace:*",
    "@factivist/ui-theme": "workspace:*",
    "@gorhom/bottom-sheet": "5.2.14",
    "@tanstack/react-query": "latest",
    "expo": "56.0.3",
    "expo-constants": "~56.0.13",
    "expo-linking": "~56.0.10",
    "expo-router": "~56.2.4",
    "expo-splash-screen": "~56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.4",
    "heroui-native": "1.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "uniwind": "1.7.0",
    "zustand": "latest"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@config-plugins/detox": "^11.0.0",
    "@factivist/tsconfig": "workspace:*",
    "@factivist/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "latest",
    "@types/node": "^24.12.4",
    "@types/react": "~19.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "detox": "^20.30.0",
    "jest-expo": "~56.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
