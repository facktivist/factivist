{
  "expo": {
    "name": "Factivist",
    "slug": "factivist-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "factivist",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.theprocedure.factivist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "in.theprocedure.factivist"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-splash-screen", "@config-plugins/detox"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
