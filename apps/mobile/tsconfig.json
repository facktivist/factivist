{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@factivist/tsconfig/react.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "incremental": true,
    "types": ["react", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.setup.ts",
    "vitest.config.ts",
    "metro.config.js",
    "babel.config.js",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".expo",
    "ios",
    "android",
    "e2e",
    "**/__tests__/**"
  ]
}
