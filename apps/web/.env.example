# Next.js — App Router admin shell.
# Copy to `.env.local` and edit. NEVER commit a real `.env*` file.
#
# These mirror the workspace-root `.env.example` so the web app stands
# alone for one-off Vercel builds or CI matrices that do not source the
# root env. When a value is set in BOTH the root `.env` and here, the
# more-specific (this file) wins inside this app per Next.js precedence.

# ─── Supabase Auth (wave-2, admin shell only) ──────────────────────────
#
# These power `apps/web/src/lib/auth/server.ts` via `@supabase/ssr`.
# The admin shell layout redirects `/admin/**` to `/` when the resolved
# session is null, so leaving these unset in production effectively
# closes the admin surface. The API has a parallel pair of envs (see
# `apps/api/.env.example` SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY).
#
#   NEXT_PUBLIC_SUPABASE_URL        — project URL, e.g.
#                                     https://<project-ref>.supabase.co
#                                     (or your custom-domain origin per
#                                     ADR-0009 / ADR-0023).
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   — the anon (public) JWT — safe to
#                                     ship to the browser; the SSR client
#                                     uses it to read the user's session
#                                     cookie. The service-role key MUST
#                                     NOT appear in this file.
#
# Dashboard configuration — set the admin role claim on each operator:
#
#   1. Supabase Dashboard → Authentication → Users → (pick a user)
#      → "Raw User Meta Data" → add { "role": "admin" } or "moderator".
#      For automation use the management API:
#        update auth.users
#          set raw_app_meta_data = jsonb_set(
#            coalesce(raw_app_meta_data, '{}'::jsonb),
#            '{role}', '"admin"'
#          )
#          where id = '<uuid>';
#      `app_metadata` is preferred (read-only from client) over
#      `user_metadata` (mutable from client). The resolver checks both
#      with `app_metadata.role` winning.
#
#   2. Citizens have NO role claim — `getServerSession` returns null and
#      the admin layout redirects them out. They are NEVER admins.
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── API origin ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8787

# ─── Test-only escape hatch ────────────────────────────────────────────
#
# `FACTIVIST_TRUSTED_HEADER_AUTH=1` enables the `x-factivist-role` /
# `x-factivist-actor-id` / `x-factivist-token` header-injected session
# fallback. It is ONLY honoured when `NODE_ENV === 'test'`. If set in
# any other environment, a startup warning is logged and the flag is
# ignored — see `apps/web/src/lib/auth/server.ts`.
#
# Leave both UNSET in production. Vitest sets them automatically.
# FACTIVIST_TRUSTED_HEADER_AUTH=
# NODE_ENV=test
