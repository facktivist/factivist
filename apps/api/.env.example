# HTTP server
PORT=3001
NODE_ENV=development

# CORS — comma-separated origins are NOT supported here; use a single origin or '*'.
# In production, set to the web app's public URL (e.g. https://app.factivist.com).
CORS_ORIGIN=http://localhost:3000

# Database — must match packages/db's expected connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/factivist
