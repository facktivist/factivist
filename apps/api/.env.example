# HTTP server
PORT=3001
NODE_ENV=development

# CORS — comma-separated origins are NOT supported here; use a single origin or '*'.
# In production, set to the web app's public URL (e.g. https://app.factivist.com).
CORS_ORIGIN=http://localhost:3000

# Database — must match packages/db's expected connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/factivist

# ZKP verification key URL (Groth16 vKey JSON). Optional in dev — when unset,
# /identity/verify returns 503 zkp_not_configured. Pipeline E will set this
# alongside the deployed CitizenVerifier.sol address in CI/CD.
FACTIVIST_ZKP_VKEY_URL=

# ─── Supabase Auth (wave-2, admin RBAC bearer verification) ───────────
# Used by `apps/api/src/lib/supabase-auth.ts` to verify `Authorization:
# Bearer <jwt>` headers on every request and populate the Hono context
# actor. The decoded actor is read by `apps/api/src/lib/rbac.ts` —
# admin/moderator routes 401 when the claim is missing or invalid.
#
#   SUPABASE_URL                  — project URL (custom-domain origin
#                                   per ADR-0009 when available).
#   SUPABASE_SERVICE_ROLE_KEY     — service-role JWT. Re-used by the
#                                   Storage finalize pipeline (see
#                                   SUPABASE_STORAGE_WEBHOOK_SECRET +
#                                   apps/api/src/lib/upload.ts). NEVER
#                                   commit a real value.
#
# Operators get role claims via the Supabase dashboard's `app_metadata`
# JSON — see apps/web/.env.example for the exact SQL.
SUPABASE_URL=
# (SUPABASE_SERVICE_ROLE_KEY is also declared below for Storage;
#  the same value powers both subsystems.)

# ─── Supabase Storage (complaint photo uploads, ADR-0004) ──────────────
# All three required for the photo upload path. The route returns
# 503 upload_not_configured when any are unset. Used by apps/api/src/lib/upload.ts.
#
#   SUPABASE_STORAGE_URL          — origin of the Supabase Storage REST API
#                                   (use the custom-domain origin per ADR-0009).
#   SUPABASE_SERVICE_ROLE_KEY     — service-role JWT (NEVER ship to client).
#   SUPABASE_PHOTO_BUCKET         — bucket name (defaults to `complaint-photos`).
#   SUPABASE_PHOTO_PUBLIC_BASE    — public CDN base for the bucket
#                                   (e.g. https://cdn.factivist.com).
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=complaint-photos
SUPABASE_PHOTO_PUBLIC_BASE=

# ─── Supabase Storage webhook (photo finalize, ADR-0004 wave 2) ─────────
# Shared HMAC-SHA256 secret used to authenticate Storage's object-created
# webhook. The finalize endpoint pulls each new upload through stripExif
# before its public URL surfaces on `complaints.photo_urls`.
#
# Setup (user-side; this app NEVER auto-configures Supabase):
#   1. Generate a 32-byte secret:  openssl rand -hex 32
#   2. Paste it below as SUPABASE_STORAGE_WEBHOOK_SECRET=...
#   3. In the Supabase dashboard:
#        Storage → bucket "complaint-photos" → Settings → Webhooks
#        - URL:     https://api.factivist.app/uploads/photo/finalize
#                   (use the custom-domain origin per ADR-0009)
#        - Events:  ObjectCreated:Put, ObjectCreated:Post
#        - Secret:  paste the SAME value used here.
#
# The finalize route returns 503 webhook_not_configured when this is unset.
SUPABASE_STORAGE_WEBHOOK_SECRET=

# ─── Signed session cookie (Phase 5 wave-2C, ADR-0010) ─────────────────
# HMAC-SHA256 key for the `factivist-session` cookie issued by
# `POST /identity/verify` and validated by `GET /identity/session`.
# The cookie binds the verify request's `sessionNonce` to the verified
# citizen — tampering or replay invalidates the signature.
#
# Setup:
#   1. Generate a 32-byte hex secret:  openssl rand -hex 32
#   2. Paste it below as FACTIVIST_SESSION_SECRET=...
#   3. ROTATE on any suspected leak — pre-rotation cookies become
#      `bad_signature` and clients are forced through /identity/verify
#      again on next request.
#
# When unset:
#   - `POST /identity/verify` still returns 200 + JSON but omits the
#     Set-Cookie header (wave-1 backward compat).
#   - `GET /identity/session` falls through to the test-mode header path
#     under NODE_ENV=test only; production returns the anon shape.
#   MUST be set in production — operators are reminded by the route
#   header doc-comment in `apps/api/src/routes/identity.ts`.
FACTIVIST_SESSION_SECRET=

# ─── Server-side ZKP prover (Phase 5 wave-2C, ADR-0011) ────────────────
# `POST /identity/prove` falls back to a server-side rapidsnark/snarkjs
# binary for devices that cannot prove in-thread (low-tier Android,
# iOS pre-A13). The binary distribution path is a Pipeline E ops task —
# the wrapper at `apps/api/src/lib/zkp-prover.ts` exposes an
# `__prover.backend` slot that tests inject; production wires the real
# binary lazily on first request.
#
# Until the binary is deployed the route returns
# `503 PROVER_NOT_CONFIGURED` — clients fall back to on-device proving.
#
# Path placeholder for the Pipeline E task — keep commented until the
# binary is packaged in the deployment image:
#   FACTIVIST_ZKP_PROVER_BIN=/opt/rapidsnark/rapidsnark
#   FACTIVIST_ZKP_ZKEY_PATH=/opt/rapidsnark/citizen.zkey
