{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@factivist/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage", "drizzle"]
}
