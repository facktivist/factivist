{
  "name": "@factivist/codegraph",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./ingest": {
      "types": "./src/ingest/index.ts",
      "default": "./src/ingest/index.ts"
    },
    "./query": {
      "types": "./src/query/index.ts",
      "default": "./src/query/index.ts"
    },
    "./bridge": {
      "types": "./src/bridge/index.ts",
      "default": "./src/bridge/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./export/obsidian": {
      "types": "./src/export/obsidian.ts",
      "default": "./src/export/obsidian.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "graph:ingest": "bun run src/cli.ts ingest",
    "graph:query": "bun run src/cli.ts query",
    "graph:export:obsidian": "bun run src/cli.ts export:obsidian"
  },
  "dependencies": {
    "kuzu": "^0.6.0"
  },
  "devDependencies": {
    "@factivist/shared": "workspace:*",
    "@factivist/tsconfig": "workspace:*",
    "@factivist/vitest-config": "workspace:*",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
