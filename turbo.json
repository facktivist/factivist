{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "biome.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@factivist/shared#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@factivist/db#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@factivist/ui-theme#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@factivist/ui-native#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@factivist/ui-web#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@factivist/codegraph#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "graph:ingest": {
      "cache": false,
      "outputs": [".codegraph/**"]
    },
    "db:migrate:age": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "check": {
      "dependsOn": ["lint", "test:coverage", "build"],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "outputs": ["drizzle/**"]
    },
    "db:migrate": {
      "cache": false,
      "outputs": []
    },
    "db:seed": {
      "cache": false,
      "outputs": []
    }
  }
}
