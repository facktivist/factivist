{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@factivist/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"]
  },
  "include": ["*.ts", "__tests__/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "coverage"]
}
