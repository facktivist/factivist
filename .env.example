# Copy to `.env` and edit. Defaults wired for `docker compose up postgres`.
#
# NEVER commit a real .env — the `env-file` guardrail in
# packages/guardrails blocks any `.env.*` flavor (except this file).

# Postgres (AGE-enabled, via docker-compose.yml)
POSTGRES_USER=factivist
POSTGRES_PASSWORD=factivist_local
POSTGRES_DB=factivist
POSTGRES_PORT=5432

# Drizzle + AGE both read DATABASE_URL. Use the direct (5432) URL for
# migrations — pgBouncer (6543) rejects DDL and prepared statements.
DATABASE_URL=postgres://factivist:factivist_local@localhost:5432/factivist

# Supabase (production / staging)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API
NEXT_PUBLIC_API_URL=http://localhost:8787

# Kuzu Explorer (opt-in dev tool)
KUZU_EXPLORER_PORT=8000

# CORS — leave unset for wildcard, set in production for hardened defaults
# CORS_ORIGIN=https://factivist.in
